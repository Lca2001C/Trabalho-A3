# ============================================================================
# ConectaBem — Variáveis de Ambiente (EXEMPLO)
# ============================================================================
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env no Git!
# ============================================================================

# Banco de dados — copie em Supabase > Settings > Database > URI
# DATABASE_URL: Use o "Transaction mode" (porta 6543) se usar Pooler
# DIRECT_URL: Use o "Session mode" (porta 5432) para migrations
DATABASE_URL="postgresql://postgres:SUA_SENHA@db.xxxx.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:SUA_SENHA@db.xxxx.supabase.co:5432/postgres"

# JWT — use uma string longa e aleatória
JWT_SECRET="sua_frase_secreta_longa_aqui_2024"

# Credenciais do administrador inicial (usadas pelo seed: node prisma/seedAdmin.js)
# ADMIN_PASSWORD é obrigatório para criar o admin — mínimo 8 caracteres
ADMIN_EMAIL="admin@conectabem.com"
ADMIN_PASSWORD=""

# Porta local
PORT=3001

# URL do frontend em produção (para configuração do CORS)
FRONTEND_URL="https://seu-projeto.vercel.app"

# Cloudinary — encontre em cloudinary.com > Dashboard
CLOUDINARY_CLOUD_NAME="seu_cloud_name"
CLOUDINARY_API_KEY="sua_api_key"
CLOUDINARY_API_SECRET="sua_api_secret"

# Resend — gere em resend.com > API Keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"

# Mercado Pago — copie em developers.mercadopago.com.br
MERCADOPAGO_TOKEN="TEST-xxxxxxxxxxxxxxxx"

# NGROK — token da sua conta gratuita (necessário para publicar o app na internet)
# Obtenha em: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=""
